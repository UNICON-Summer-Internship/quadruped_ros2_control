<?xml version="1.0"?>
<!--
  Velodyne VLP-16, ported from clearpath_ws (garisani_go2/urdf/velodyne.xacro)
  so this stack can use the same lidar the rest of the project already maps with.

  Why not the built-in L1: it is a head-mounted 200-degree, 10 m sensor. On the
  outdoor pipeline world 79% of its rays hit nothing, leaving ~2.1k usable points
  per scan. The VLP-16 is 360 degrees and 131 m.

  Geometry is a plain cylinder rather than the VLP16_*.dae meshes (those live in
  clearpath_ws, and dragging them in would couple the two workspaces). Only the
  collision/inertial and the sensor origin matter for simulation; the visual is
  cosmetic.

  Mounted on `trunk` (this stack's body link; clearpath_ws calls it base_link),
  level and on top, so the 360-degree scan is not blocked by the body.

  Publishes to `scan`, the same topic the L1 used, so the bridge, the
  `/scan/points` consumers and lidar_time_relay all keep working unchanged.
  Only frame_id differs (`velodyne` instead of `lidar`), and TF for it comes from
  robot_state_publisher via the fixed joints below.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="velodyne_vlp16" params="parent *origin">
    <joint name="velodyne_base_mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="velodyne_base_link"/>
    </joint>

    <link name="velodyne_base_link">
      <inertial>
        <mass value="0.83"/>
        <origin xyz="0 0 0.03585"/>
        <inertia ixx="0.000908059425" ixy="0" ixz="0"
                 iyy="0.000908059425" iyz="0" izz="0.0011049624"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0.03585"/>
        <geometry>
          <cylinder length="0.0717" radius="0.0516"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0.03585"/>
        <geometry>
          <cylinder length="0.0717" radius="0.0516"/>
        </geometry>
      </collision>
    </link>

    <!-- The scan origin sits above the base, same offset as the real VLP-16. -->
    <joint name="velodyne_base_scan_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0.0377"/>
      <parent link="velodyne_base_link"/>
      <child link="velodyne"/>
    </joint>

    <link name="velodyne">
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Sensor definition. Values match clearpath_ws so measurements carry over. -->
  <xacro:macro name="velodyne_vlp16_gazebo" params="topic:=scan">
    <gazebo reference="velodyne">
      <sensor name="velodyne-VLP16" type="gpu_lidar">
        <topic>${topic}</topic>
        <update_rate>10</update_rate>
        <gz_frame_id>velodyne</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>440</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.5</min>
            <max>131.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.008</stddev>
          </noise>
          <frame_id>velodyne</frame_id>
        </lidar>
        <visualize>true</visualize>
        <always_on>1</always_on>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
