<?xml version='1.0' encoding='UTF-8'?>
<sdf version='1.4'>
  <world name='pipeline'>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>
    <!-- PX4 SITL 이 요구하는 환경 (기압계·지자기계 센서 모델용).
         드론 파트 통합 시 pipeline_px4.sdf 에서 가져왔다. -->
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <plugin name='gz::sim::systems::Physics' filename='libgz-sim-physics-system.so'/>
    <plugin name='gz::sim::systems::UserCommands' filename='libgz-sim-user-commands-system.so'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='libgz-sim-scene-broadcaster-system.so'/>
    <plugin name="gz::sim::systems::Sensors" filename="libgz-sim-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="libgz-sim-imu-system.so"/>
    <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>
    <!-- PX4 SITL 요구 플러그인 -->
    <plugin name="gz::sim::systems::AirPressure" filename="libgz-sim-air-pressure-system.so"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="libgz-sim-magnetometer-system.so"/>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <shadows>1</shadows>
    </scene>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1.0</direction>
    </light>

    <!-- Origin placed in northern Alberta, Canada  -->
    <spherical_coordinates>
      <latitude_deg>57.0271155</latitude_deg>
      <longitude_deg>-115.426770</longitude_deg>
      <elevation>600</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <model name='pipeline'>
      <pose>0 20 -1 0 0 3.14159</pose>
      <static>true</static>
      <link name='pipeline'>
        <collision name='pipeline_collision'>
          <geometry>
            <mesh>
              <uri>
                model://pipeline/inspection_world.dae
              </uri>
              <scale>2 2 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- 지면 마찰. 실제 접촉은 발×지면 곱이라 로봇 쪽 값과 같이 봐야 한다
                     (Go2 발은 garisani_go2/urdf/unitree_go2_gazebo.xacro 의 foot_mu).
                     명시 안 하면 SDF 기본값 1.0 이 쓰인다 — 값이 안 보여서
                     "왜 미끄러지지" 를 추적하기 어려웠다. 그래서 명시해 둔다. -->
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='pipeline_visual'>
          <geometry>
            <mesh>
              <uri>
                model://pipeline/inspection_world.dae
              </uri>
              <scale>2 2 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name='water_level'>
      <pose>0 20 -1 0 0 3.14159</pose>
      <static>true</static>
      <link name='water_level'>
        <!-- no collision -->
        <visual name='water_level_visual'>
          <geometry>
            <mesh>
              <uri>
                model://pipeline/inspection_water.dae
              </uri>
              <scale>2 2 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name='base_station'>
      <pose>0 8 0 0 0 0</pose>
      <static>true</static>
      <link name='base_station'>
        <collision name='base_station_collision'>
          <geometry>
            <mesh>
              <uri>
                model://accessories/base_station_with_tripod.stl
              </uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- 지면 마찰. 실제 접촉은 발×지면 곱이라 로봇 쪽 값과 같이 봐야 한다
                     (Go2 발은 garisani_go2/urdf/unitree_go2_gazebo.xacro 의 foot_mu).
                     명시 안 하면 SDF 기본값 1.0 이 쓰인다 — 값이 안 보여서
                     "왜 미끄러지지" 를 추적하기 어려웠다. 그래서 명시해 둔다. -->
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='base_station_visual'>
          <geometry>
            <mesh>
              <uri>
                model://accessories/base_station_with_tripod.dae
              </uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
